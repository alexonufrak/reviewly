{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chat-capability",
  "description": "Detached AI-chat satellite windows (label chat-*)",
  "windows": ["chat-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "clipboard-manager:default",
    "os:default",
    "dialog:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close"
  ]
}
